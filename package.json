{
  "name": "match-pulse",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --env-file=.env.local --path-ignore-patterns='tests/fault-injection/**' --path-ignore-patterns='tests/e2e/**'",
    "auth:organizer": "bun --env-file=.env.local scripts/create-organizer.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "smoke": "bun scripts/smoke-test.ts",
    "fault:inject": "bun scripts/fault-injection.ts",
    "auth:club": "bun --env-file=.env.local scripts/create-club.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:secrets": "bun scripts/check-secrets.ts",
    "perf": "bun --env-file=.env.local scripts/performance.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
